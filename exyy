-- Q TP（キャラの向き前方3stud）
--====================================================
MakeButton("Q TP",function()
    local c = LP.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = hrp.CFrame + hrp.CFrame.LookVector*3
    end
end)

UIS.InputBegan:Connect(function(key,g)
    if g then return end
    if key.KeyCode == Enum.KeyCode.Q then
        local c = LP.Character
        local hrp = c and c:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.CFrame = hrp.CFrame + hrp.CFrame.LookVector*3 end
    end
end)

--====================================================
-- Fly（向いてる方向に飛ぶ）
--====================================================
local FlyEnabled = false
local FlySpeed = 60

MakeButton("Fly Toggle",function() FlyEnabled = not FlyEnabled end)
local FlyInputConn
UIS.InputBegan:Connect(function(key,g)
    if g then return end
    if key.KeyCode == Enum.KeyCode.F then FlyEnabled = not FlyEnabled end
end)

RunService.Heartbeat:Connect(function(dt)
    local c = LP.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    local cam = W.CurrentCamera
    if FlyEnabled and hrp and cam then
        hrp.Velocity = cam.CFrame.LookVector*FlySpeed
    end
end)

--====================================================
-- Third（足場作成）
--====================================================
local ThirdEnabled = false
local platform
MakeButton("3rd Toggle",function()
    local c = LP.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if ThirdEnabled then
        if platform then platform:Destroy() platform = nil end
        ThirdEnabled = false
    else
        platform = Instance.new("Part")
        platform.Size = Vector3.new(4,0.5,4)
        platform.Position = hrp.Position - Vector3.new(0,3,0)
        platform.Anchored = true
        platform.CanCollide = true
        platform.Parent = W
        ThirdEnabled = true
        task.spawn(function()
            while ThirdEnabled do
                platform.Position = hrp.Position - Vector3.new(0,3,0)
                task.wait(0.1)
            end
        end)
    end
end)

UIS.InputBegan:Connect(function(key,g)
    if g then return end
    if key.KeyCode == Enum.KeyCode.V then
        local c = LP.Character
        local hrp = c and c:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        if ThirdEnabled then
            if platform then platform:Destroy() platform=nil end
            ThirdEnabled=false
        else
            platform = Instance.new("Part")
            platform.Size=Vector3.new(4,0.5,4)
            platform.Position=hrp.Position-Vector3.new(0,3,0)
            platform.Anchored=true
            platform.CanCollide=true
            platform.Parent=W
            ThirdEnabled=true
            task.spawn(function()
                while ThirdEnabled do
                    platform.Position=hrp.Position-Vector3.new(0,3,0)
                    task.wait(0.1)
                end
            end)
        end
    end
end)

